# 固定模型服务密钥。实际部署时填入运行主机的环境变量，不要提交此文件或密钥。
API_KEY=

# Aspen bridge settings. The bridge token must be identical on the Windows
# Aspen host and the Render web service; never commit the real token.
ASPEN_BRIDGE_URL=
ASPEN_BRIDGE_TOKEN=
ASPEN_BRIDGE_HOST=127.0.0.1
ASPEN_BRIDGE_PORT=8765

# Optional: JSON parameter ledger path. See README.md for the format.
BINARY_PARAMETER_LEDGER=

# Optional: editable multilingual alias JSON path. Defaults to component_aliases.json.
COMPONENT_ALIAS_FILE=

# ThermoML uses the public NIST/TRC Search API and DOI JSON endpoints; no private URL is needed.
